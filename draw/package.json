{
  "name": "jdraw",
  "productName": "JDraw",
  "version": "0.1.0",
  "description": "A drawing app with AI agents that draw, color and shade with you",
  "main": "main.cjs",
  "private": true,
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "set JDRAW_DEV=1&& electron .",
    "smoke": "electron . --smoke",
    "pack": "electron-builder --dir"
  },
  "devDependencies": {
    "electron": "45.2.1",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "app.jsystems.jdraw",
    "productName": "JDraw",
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "lib/**",
      "renderer/**",
      "skills/**",
      "checker/**",
      "package.json"
    ],
    "asarUnpack": [
      "checker/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    }
  }
}
